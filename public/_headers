# Security headers for every page, then the cache rules (they stack: a file gets both).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), interest-cohort=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://*.supabase.co; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# The worker file, the front page and the manifest must always be re-checked, or a phone can stay on an old version for a day
/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

# Which build is live: never stored
/version.json
  Cache-Control: no-store

# Files under /assets/ have a fingerprint in their name, so they can be kept for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable